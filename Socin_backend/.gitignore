# =========================
# Python / Django .gitignore
# =========================

# --- Python bytecode / caches ---
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.pytype/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/
.tox/
nosetests.xml
test-results/

# --- Packaging / build artifacts ---
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Virtual environments ---
.venv/
venv/
env/
.env/
ENV/
VENV/

# --- Environment / secrets ---
.env
*.env
.env.*
*.local
*.secret
secrets*.json

# --- Django specific ---
*.log
local_settings.py
db.sqlite3
*.sqlite3
*.sqlite3-journal
data.json
celerybeat-schedule

# If you use Django's collected static root, keep source static tracked
staticfiles/
static_root/

# User uploads
media/

# --- IDE / OS ---
.idea/
.vscode/
.DS_Store
Thumbs.db
desktop.ini

# --- Node (if present in project) ---
node_modules/
